Host fixes for GNU GCC 2.95.2, applied to the pinned archive by the Makefile.
Each section says where it is needed and why it cannot change what the
compiler writes. `patch` skips this prose.

== 1. Cast-as-lvalue =====================================================
Needed on: every host; current C compilers reject a cast as an lvalue.
arm_prog_mode is a macro casting arm_prgmode to enum prog_mode; assigning
the variable itself stores the same value.

--- a/gcc/config/arm/arm.c
+++ b/gcc/config/arm/arm.c
@@ -528,3 +528,3 @@
   
-  arm_prog_mode = TARGET_APCS_32 ? PROG_MODE_PROG32 : PROG_MODE_PROG26;
+  arm_prgmode = TARGET_APCS_32 ? PROG_MODE_PROG32 : PROG_MODE_PROG26;
   

== 2. Darwin's sys_nerr declaration ======================================
Needed on: macOS, whose <stdio.h> declares `extern const int sys_nerr`.
A declaration only; libiberty's strerror is not on any code-generation path.

--- a/libiberty/strerror.c
+++ b/libiberty/strerror.c
@@ -464,3 +464,7 @@
 
+#ifdef __APPLE__
+extern const int sys_nerr;
+#else
 extern int sys_nerr;
+#endif
 extern char *sys_errlist[];

== 3. Unprototyped generator table =======================================
Needed on: macOS arm64, where a call through a variadic prototype passes
every argument after the first on the stack while the gen_* functions,
which are not variadic, read them from registers. Unpatched, cc1 crashes on
3,892 of 4,133 test units. genoutput.c:256 already defines the table as
`rtx (*const insn_gen_function[]) ()`; this makes the declaration at
expr.h:377 agree. It changes only how the host calls the generators, never
which generator runs or with what operands.

--- a/gcc/expr.h
+++ b/gcc/expr.h
@@ -376,3 +376,3 @@
 
-extern rtx (*const insn_gen_function[]) PROTO ((rtx, ...));
+extern rtx (*const insn_gen_function[]) ();
 

== 4. Host model asserts =================================================
Needed on: every host. The build claims the i686 descriptor on whatever
machine compiles it; these compile-time checks refuse a machine that does
not behave like it (32-bit int, signed char, little-endian, doubles kept
as doubles: on i386 that means SSE2 arithmetic). No code is generated.

--- a/gcc/config/i386/xm-i386.h
+++ b/gcc/config/i386/xm-i386.h
@@ -35,2 +35,17 @@
 
+/* The host model this descriptor promises, checked on whatever machine
+   really compiles it: 32-bit int (HOST_WIDE_INT), signed plain char,
+   little-endian, and doubles evaluated as doubles.  */
+typedef char host_int_is_32_bits[sizeof (int) == 4 ? 1 : -1];
+typedef char host_char_is_signed[(char) -1 < 0 ? 1 : -1];
+#if defined (__BYTE_ORDER__) && __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+#error "the host must be little-endian"
+#endif
+#if defined (__i386__) && ! defined (__SSE2_MATH__)
+#error "on i386 build with CC='cc -msse2 -mfpmath=sse'"
+#endif
+#if defined (__FLT_EVAL_METHOD__) && __FLT_EVAL_METHOD__ != 0
+#error "the host must evaluate double arithmetic in double"
+#endif
+
 /* Arguments to use with `exit'.  */

== 5. CONST_DOUBLE ints, one operand slot at a time ======================
Needed on: hosts with 64-bit pointers. A floating CONST_DOUBLE keeps its
value as HOST_WIDE_INTs (32-bit here) in consecutive operand slots, and the
code copies them with one bcopy from &CONST_DOUBLE_LOW. A slot is as wide
as a pointer, so on a 64-bit host the second int is read from the unused
upper half of the first slot: uninitialised memory. On a 32-bit host the
slots are adjacent ints and the loop copies exactly the bytes bcopy did,
so the reference host's output cannot change. Sites: real.h:468,
emit-rtl.c:3702, varasm.c:3251 and 3675, arm.c:4649, arm.md:6223 and 6246.
(varasm.c:2107/2123 are dead when the value fits two ints; thumb.md is not
built for arm-elf.)

--- a/gcc/real.h
+++ b/gcc/real.h
@@ -467,5 +467,18 @@
 
+/* Copy a real value's ints out of, or into, a CONST_DOUBLE one operand
+   slot at a time.  A slot is as wide as a host pointer, so on a host
+   whose pointers are wider than HOST_WIDE_INT the ints are not adjacent
+   in memory and one block copy from &CONST_DOUBLE_LOW is wrong.  */
+#define CONST_DOUBLE_GET_INTS(u, x)					\
+do { unsigned int i_;							\
+     for (i_ = 0; i_ < sizeof (u).i / sizeof (u).i[0]; i_++)		\
+       (u).i[i_] = XWINT ((x), 2 + i_); } while (0)
+#define CONST_DOUBLE_SET_INTS(x, u)					\
+do { unsigned int i_;							\
+     for (i_ = 0; i_ < sizeof (u).i / sizeof (u).i[0]; i_++)		\
+       XWINT ((x), 2 + i_) = (u).i[i_]; } while (0)
+
 #define REAL_VALUE_FROM_CONST_DOUBLE(to, from)		\
 do { union real_extract u;				\
-     bcopy ((char *) &CONST_DOUBLE_LOW ((from)), (char *) &u, sizeof u); \
+     CONST_DOUBLE_GET_INTS (u, (from));			\
      to = u.d; } while (0)
--- a/gcc/emit-rtl.c
+++ b/gcc/emit-rtl.c
@@ -3701,3 +3701,3 @@
 
-	  bcopy ((char *) &u, (char *) &CONST_DOUBLE_LOW (tem), sizeof u);
+	  CONST_DOUBLE_SET_INTS (tem, u);
 	  CONST_DOUBLE_MEM (tem) = cc0_rtx;
--- a/gcc/varasm.c
+++ b/gcc/varasm.c
@@ -3250,4 +3250,3 @@
 	  value->mode = GET_MODE (x);
-	  bcopy ((char *) &CONST_DOUBLE_LOW (x),
-		 (char *) &value->un.du, sizeof value->un.du);
+	  CONST_DOUBLE_GET_INTS (value->un.du, x);
 	}
@@ -3674,3 +3673,3 @@
 
-	  bcopy ((char *) &CONST_DOUBLE_LOW (x), (char *) &u, sizeof u);
+	  CONST_DOUBLE_GET_INTS (u, x);
 	  assemble_real (u.d, pool->mode);
--- a/gcc/config/arm/arm.c
+++ b/gcc/config/arm/arm.c
@@ -4648,4 +4648,3 @@
 
-	      bcopy ((char *) &CONST_DOUBLE_LOW (operands[1]), (char *) &u,
-		     sizeof (u));
+	      CONST_DOUBLE_GET_INTS (u, operands[1]);
 	      REAL_VALUE_TO_TARGET_DOUBLE (u.d, l);
--- a/gcc/config/arm/arm.md
+++ b/gcc/config/arm/arm.md
@@ -6222,3 +6222,3 @@
       union real_extract u;
-      bcopy ((char *) &CONST_DOUBLE_LOW (operands[0]), (char *) &u, sizeof u);
+      CONST_DOUBLE_GET_INTS (u, operands[0]);
       assemble_real (u.d, GET_MODE (operands[0]));
@@ -6245,3 +6245,3 @@
       union real_extract u;
-      bcopy ((char *) &CONST_DOUBLE_LOW (operands[0]), (char *) &u, sizeof u);
+      CONST_DOUBLE_GET_INTS (u, operands[0]);
       assemble_real (u.d, GET_MODE (operands[0]));
